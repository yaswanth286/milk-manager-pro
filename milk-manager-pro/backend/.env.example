# Copy this file to ".env" and fill in real values. Never commit ".env" to git.

# PostgreSQL connection string
DATABASE_URL=postgresql://milkuser:milkpass@localhost:5432/milk_manager_pro

# Secret key used to sign JWT tokens - use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# How long a login session (JWT) stays valid, in minutes. 720 = 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of frontend URLs allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
